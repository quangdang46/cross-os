tmp/
.DS_Store

# reference repos cloned for code archaeology (see §9 of COMPREHENSIVE_PLAN.md)
.tmp/
# beads local runtime (SQLite WAL, locks, caches) — only JSONL is committed
.beads/*.db*
.beads/*.fsqlite*
.beads/*-lock-*
.beads/last-touched
*.exe
# Built Windows helper DLL is a reproducible CMake artifact (platform/windows),
# not a source — same policy as *.exe test binaries above. CI rebuilds it;
# the tree keeps sources only.
*.dll

# xcodegen output: project.yml is the source of truth (regenerate with
# `xcodegen generate --spec extensions/finder-sync/project.yml
# --project extensions/finder-sync`). The generated .xcodeproj is committed
# anyway (CLT-only machines cannot regenerate without XcodeGen... but it is
# installed via brew; committed for CI convenience + review visibility).
# Per-user Xcode state is never committed:
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
xcuserdata/
DerivedData/
*.xcuserstate
