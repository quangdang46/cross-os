<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Temp exception so the extension can stat the right-clicked folder.
         Notarization-friendly (same shape as the newfile source). MAS would
         require security-scoped bookmarks instead — out of scope (see
         docs/backlog/windows-shell-menu.md MAS note pattern). -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/Users/</string>
        <string>/Volumes/</string>
        <string>/private/tmp/</string>
    </array>
    <!-- App-group containers MUST be Team-ID-prefixed (containermanagerd
         rejects otherwise — newfile v0.2.1 lesson, do not regress).
         TEAM_ID is filled at signing time; dev builds use the local team. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TEAM_ID).dev.crossos.finder-sync</string>
    </array>
</dict>
</plist>
